# Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Long random string. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Resend. The sending domain needs verified DKIM + SPF or healthcare spam filters
# will silently quarantine every alert.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.example
ALERT_TO_EMAIL=team.lead@facility.example
